{
  "name": "bio-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data": "node scripts/build-tri.mjs && mapshaper public/data/tri-facilities.geojson -join data-raw/counties-500k.geojson fields=GEOID -rename-fields county_fips=GEOID -o public/data/tri-facilities.geojson force && node scripts/build-counties.mjs",
    "data:download": "bash scripts/download-data.sh"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "csv-parse": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.3",
    "mapshaper": "^0.7.100",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
